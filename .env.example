# 1. Supabase Configuration (Optional for demo, required for cloud production)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. LLM / AI Configuration
# Google Gemini API key (recommended) or OpenAI API key
# When provided, real-time embeddings & LLM responses will use this API.
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OPENAI_API_KEY=sk-...

# 3. Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
